5:["$","$Lf",null,{"children":["$","div",null,{"className":"ui-module__QlBvra__page","children":[[["$","header",null,{"className":"ui-module__QlBvra__hero","style":{"--m1":"#8a5cf0","--m2":"#cdb6ff","--kb":"#ffb35c","--rb":"#7d93ff"},"children":[["$","$L10",null,{"mood":"mind","className":"ui-module__QlBvra__heroField"}],["$","div",null,{"className":"ui-module__QlBvra__heroCopy","children":[["$","$L11",null,{"className":"ui-module__QlBvra__back","href":"/lab","children":[["$","span",null,{"aria-hidden":true,"children":"←"}]," ","Lab"]}],["$","h1",null,{"className":"ui-module__QlBvra__title","children":"Proof"}],["$","p",null,{"className":"ui-module__QlBvra__lede","children":"Is there really an AI inside? Here is what you can check yourself, and what nobody can."}],false]}]]}],["$","div",null,{"className":"ui-module__QlBvra__head","children":["$","p",null,{"className":"ui-module__QlBvra__detail","children":"The agent's key is made and kept inside attested hardware, the code that holds it is on a public allow-list, and every action it takes is a signed record in a log whose head is anchored on-chain. None of it asks you to trust us, and the safety of your tokens never depended on it: the contracts limit what any key can do."}]}]],["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"What is claimed"}],"$undefined"]}],["$","ul",null,{"className":"proof-module__ldnZ6q__claims","children":[["$","li","The agent key exists only inside an Intel TDX machine on Phala. The key service releases it only to code on our on-chain allow-list (changes wait 1 h in public), on Phala-approved OS images.",{"className":"proof-module__ldnZ6q__claim","children":[["$","p",null,{"className":"proof-module__ldnZ6q__claimText","children":"The agent key exists only inside an Intel TDX machine on Phala. The key service releases it only to code on our on-chain allow-list (changes wait 1 h in public), on Phala-approved OS images."}],["$","p",null,{"className":"proof-module__ldnZ6q__how","children":["A fresh TDX quote from the enclave; the compose hash on the DstackApp allow-list on Ethereum; the quote's agent key = registry.agent().","$undefined"]}]]}],["$","li","Every on-chain action follows from a published record: the model's output plus the chain data it judged, referenced by block hash. Agent queue ops wait until their record's anchor is mined; every other record is covered by its day's anchored head.",{"className":"proof-module__ldnZ6q__claim","children":[["$","p",null,{"className":"proof-module__ldnZ6q__claimText","children":"Every on-chain action follows from a published record: the model's output plus the chain data it judged, referenced by block hash. Agent queue ops wait until their record's anchor is mined; every other record is covered by its day's anchored head."}],["$","p",null,{"className":"proof-module__ldnZ6q__how","children":["The enclave-signed log chain; the record viewer below re-runs the public mapper; anyone can replay eth_getLogs over the referenced blocks.","$undefined"]}]]}],["$","li","The team cannot sign as the agent or change its code without a public, delayed on-chain trace.",{"className":"proof-module__ldnZ6q__claim","children":[["$","p",null,{"className":"proof-module__ldnZ6q__claimText","children":"The team cannot sign as the agent or change its code without a public, delayed on-chain trace."}],["$","p",null,{"className":"proof-module__ldnZ6q__how","children":["Timelock events and ComposeHashAdded / ComposeHashRemoved on the DstackApp: every allowed compose hash is a public event.","$undefined"]}]]}],["$","li","Images on its posts: the art is generated outside the enclave and checked inside it; every number and address on an image is drawn by the enclave; the image's sha256 is in the signed post record.",{"className":"proof-module__ldnZ6q__claim","children":["$L13","$L14"]}],"$L15","$L16","$L17"]}]]}],"$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20"]}]}]
