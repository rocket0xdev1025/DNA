1d:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"The brain's persona"}],["$","span",null,{"className":"ui-module__QlBvra__note","children":"and its self-file"}]]}],[["$","p",null,{"className":"ui-module__QlBvra__prose ui-module__QlBvra__muted","children":"The personality is private; its fingerprint is public, so any change is visible. Every brain decision record names the sha256 of the persona it ran under, its context and its self-file."}],["$","div",null,{"className":"ui-module__QlBvra__tableWrap","children":["$","table",null,{"className":"ui-module__QlBvra__table","children":["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Persona"}],["$","td",null,{"children":[["$","span",null,{"className":"proof-module__ldnZ6q__hash","children":"92a5973b5bbd3607eac0304c335ea6135039c1790e160038dd46d6a65920c477"}],["$","span",null,{"className":"ui-module__QlBvra__dim","children":" (sha256 of the private persona file: who it is, what it puts first, how it talks)"}]]}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Context"}],["$","td",null,{"children":[["$","span",null,{"className":"proof-module__ldnZ6q__hash","children":"41c87b327992fdddfd27618613f35a2c36ae587195d85d8be7c86aaeeee38058"}],["$","span",null,{"className":"ui-module__QlBvra__dim","children":" (the contract limits, policy, caps and rules, generated from the code)"}]]}]]}],["$","tr",null,{"children":[["$","th",null,{"scope":"row","children":"Self-file"}],["$","td",null,{"children":[["$","a",null,{"className":"ui-module__QlBvra__link proof-module__ldnZ6q__hash","href":"/api/log/3","target":"_blank","rel":"noopener noreferrer","children":"816254b9e0713e825481f3b265740f440d66767642f24c3883d0cfe67d5801f1"}],["$","span",null,{"className":"ui-module__QlBvra__dim","children":[" (","2026-10-11",": built daily by code from the contracts, the chain and the signed log; record ","3",")"]}]]}]]}]]}]}]}]]]}]
1e:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"Where humans still touch it"}],"$undefined"]}],["$","ul",null,{"className":"proof-module__ldnZ6q__list","children":[["$","li","The Safe (2-of-3)",{"children":[["$","strong",null,{"children":"The Safe (2-of-3)"}],": ","can veto any queued op within 1 h, pause the agent, lower its level, and is the timelock's proposer for code changes."]}],["$","li","Human review of new module bytecode",{"children":[["$","strong",null,{"children":"Human review of new module bytecode"}],": ","the agent can only register code the Safe approved by hash."]}],["$","li","Telegram /halt, /dryrun, /mute and /delete",{"children":[["$","strong",null,{"children":"Telegram /halt, /dryrun, /mute and /delete"}],": ","signers can stop the engine, hold it in dry run, stop its X posting, delete one of its own posts, and reject a draft. These are brakes: they only restrict or remove, and none of them can make the agent act, post or approve anything."]}],["$","li","Safe owner signatures",{"children":[["$","strong",null,{"children":"Safe owner signatures"}],": ","approving a drafted post takes one Safe owner's signature over that exact draft; approving or vetoing a delayed record takes owner signatures too (a veto needs two). Telegram only carries the signature; the engine checks it against the Safe's owners on-chain."]}],["$","li","The Phala Cloud account",{"children":[["$","strong",null,{"children":"The Phala Cloud account"}],": ","the operator holds it: it can stop or redeploy the machine, never read the key or change the allowed code."]}],["$","li","The X account",{"children":[["$","strong",null,{"children":"The X account"}],": ","the operator keeps its password and 2FA and can revoke the app; posts are automated within fixed rules."]}],["$","li","Idea intake and restrict-only jobs",{"children":[["$","strong",null,{"children":"Idea intake and restrict-only jobs"}],": ","X mentions become idea submissions; the database can ask for a canary to end or a kill check, which the enclave re-derives from chain data."]}]]}]]}]
1f:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"What is not claimed"}],"$undefined"]}],["$","ul",null,{"className":"proof-module__ldnZ6q__list","children":[[["$","li","That a given text really came from Grok or Claude: no provider signs its responses.",{"children":"That a given text really came from Grok or Claude: no provider signs its responses."}],["$","li","That no human influences it: prompts, parameters and data feeds are human-chosen, and the public can submit ideas.",{"children":"That no human influences it: prompts, parameters and data feeds are human-chosen, and the public can submit ideas."}],["$","li","\"Autonomous\", \"trustless\" or \"unhackable\". Trust remains in Intel TDX, in Phala's platform governance and in our Safe.",{"children":"\"Autonomous\", \"trustless\" or \"unhackable\". Trust remains in Intel TDX, in Phala's platform governance and in our Safe."}]],["$","li",null,{"children":"Outside our control, disclosed: Phala's key-service owner (a 2-of-3 Safe, upgradeable, no delay) can change the key service's policy. We watch it; we cannot prevent it."}]]}]]}]
20:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"Verify independently"}],"$undefined"]}],[["$","p",null,{"className":"proof-module__ldnZ6q__notice","children":["These checks are ours: run them yourself instead of trusting this page. The command-line verifier does the same against Intel's own collateral service:",["$","code",null,{"className":"proof-module__ldnZ6q__cmd","children":"# source and verifier published with the engine release\nnode scripts/verify.ts --attestation <url> --rpc <your node> --log https://genomedna.xyz"}]]}],["$","p",null,{"className":"ui-module__QlBvra__prose ui-module__QlBvra__muted","children":"Anthropic and xAI do not review, verify or endorse what DNA's models decide; their outputs are used under their terms. The posts on X are written with Grok, the default model for that role. Swapping one needs a public tryout on fixed test cases, then a public hour, and the Safe can veto. Swapping the brain itself needs two Safe owners to approve."}]]]}]
