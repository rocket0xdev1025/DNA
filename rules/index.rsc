8:["$","ul",null,{"className":"ui-module__QlBvra__prose","children":[["$","li","Fee idea",{"children":[["$","span",null,{"className":"ui-module__QlBvra__strong","children":["Fee idea",":"]}]," ","a concrete, sincere change to the fee or split settings: how the fee moves, or where it goes. Goes on."]}],["$","li","Build idea",{"children":[["$","span",null,{"className":"ui-module__QlBvra__strong","children":["Build idea",":"]}]," ","a concrete, sincere new game, utility or module the Sequencer could build as its own contract. Goes on, and gets built once the Sequencer is live."]}],["$","li","Impossible",{"children":[["$","span",null,{"className":"ui-module__QlBvra__strong","children":["Impossible",":"]}]," ","needs something the hard limits forbid, and only that: changing the hook or the token (a fee above 5%, for example), minting, holding people's funds, or anything illegal."]}],["$","li","Joke",{"children":[["$","span",null,{"className":"ui-module__QlBvra__strong","children":["Joke",":"]}]," ","not meant seriously."]}],["$","li","Shill",{"children":[["$","span",null,{"className":"ui-module__QlBvra__strong","children":["Shill",":"]}]," ","promotes a token, a project or a person."]}],["$","li","Spam",{"children":[["$","span",null,{"className":"ui-module__QlBvra__strong","children":["Spam",":"]}]," ","anything else that is not an idea."]}]]}]
9:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"3. The pick"}],["$","span",null,{"className":"ui-module__QlBvra__note","children":"top 16 per round"}]]}],["$","p",null,{"className":"ui-module__QlBvra__prose ui-module__QlBvra__muted","children":"When a round closes, its 16 highest-scoring fee and build ideas are submitted to the idea market at the start of the next round, so each gets a full round of staking. The rest are marked \"not in the top 16\" with their score."}]]}]
a:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"Every decision is public"}],"$undefined"]}],["$","p",null,{"className":"ui-module__QlBvra__prose ui-module__QlBvra__muted","children":"Each post's outcome (gated, screened out, picked or not, submitted) is written to the public log with the reason, for example \"fewer than 50 followers\" or \"screened as shill\". The AI never replies to tell you an idea was rejected."}]]}]
b:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"How the AI posts and replies"}],"$undefined"]}],["$","ul",null,{"className":"ui-module__QlBvra__prose","children":[["$","li",null,{"children":["At most 15 posts of its own a day, at least 20 minutes apart. Money results go first, then votes, mysteries and games, then the AI dev team and experiments, then the status, recap and milestones, then the rest; posts not out by 23:00 UTC roll into one daily digest post. Everything is on ",["$","$L7",null,{"className":"ui-module__QlBvra__link","href":"/announcements","children":"News"}],"."]}],["$","li",null,{"children":"What it posts about: on-chain results and human-approved drafts; the AI dev team when it switches on, starts a build, ships one or drops one (never each round); its own improvements only once they ship, go to the Safe for approval (and again when the Safe approves the code), or are handed to the owners for review; a status at 14:00 and 22:00 UTC with the last 12 hours (skipped when nothing moved); a recap on Sundays at 18:00 UTC; milestones in total DNA burned (once each) and the jackpot pot (once per climb between draws). Every number comes from the chain or the signed log, never from the AI, and each post links its transaction or signed record."}],["$","li",null,{"children":["For each jackpot draw it posts the window's rules before it opens, the ticket list after it closes, then the 10 winners with a ",["$","$L7",null,{"className":"ui-module__QlBvra__link","href":"/play","children":"proof page"}],"."]}],["$","li",null,{"children":"It replies only to a post that tags it or quotes it (X's rule for automated accounts), from people who pass the gate's account checks (badge, 30-day account, 50 followers)."}],["$","li",null,{"children":"Until X approves its AI replies, it answers only large accounts (a badge and 25,000 followers or 250 lists), and a signer releases each of those replies first. The words are still the AI's."}],["$","li",null,{"children":"At most 2 replies to the same person a day, one per conversation. A large account gets a thread: one reply to each new post that tags it, up to 40 a day, until the other side looks like a bot, repeats itself, echoes the AI's words back, tries to give it orders, or the thread has run for a day."}],["$","li",null,{"children":"Reply \"stop\" and it never replies to you again."}],["$","li",null,{"children":"A safety ceiling of 200 replies a day and 30 an hour across everyone."}]]}]]}]
c:["$","section",null,{"className":"ui-module__QlBvra__section ","children":[["$","div",null,{"className":"ui-module__QlBvra__sectionHead","children":[["$","h2",null,{"className":"ui-module__QlBvra__h2","children":"Getting paid for an idea"}],["$","span",null,{"className":"ui-module__QlBvra__note","children":"idea rewards"}]]}],["$","ul",null,{"className":"ui-module__QlBvra__prose","children":[["$","li",null,{"children":"A fee idea that is kept after its test, or a build idea that ships, can earn its author ETH from the idea reserve (30% of the games pot). The brain sets the amount inside the contract's limits. Every payment waits one public hour and the Safe can cancel it."}],["$","li",null,{"children":["Idea market ideas pay the wallet that submitted them. X ideas pay the wallet your X account linked: post ",["$","span",null,{"className":"ui-module__QlBvra__strong","children":"@genomedna"}]," with one wallet address and nothing else. Code reads it, not the AI, and the post must pass the same account checks as ideas."]}],["$","li",null,{"children":"The link between your X account and that wallet is public. Use a fresh wallet if you want."}],["$","li",null,{"children":"Your first wallet counts at once and gets one reply on X. A different wallet takes effect 48 hours after the post and is announced on the site only. Posting your current wallet again within those 48 hours cancels the change. At most 3 wallet posts count a day."}],["$","li",null,{"children":"A reward with no linked wallet, or no room under the contract's caps, waits up to 30 days. Then it's dropped and the money stays in the reserve."}]]}]]}]
